{
  "description": "claudeTalk: talk mode. On each prompt (if talk mode is on) reminds Claude it is being listened to; when Claude finishes, speaks the short answer; when a session starts, registers it and leaves voice dictation running (if installed).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claudetalk.exe\" hook stop",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claudetalk.exe\" hook session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/claudetalk.exe\" hook prompt",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
