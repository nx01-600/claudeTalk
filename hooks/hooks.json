{
  "description": "claudeTalk: when Claude finishes responding, reads the response out loud if voice mode is on; when a session starts, leaves voice dictation running (if installed).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/speak.ps1\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/scripts/voice-daemon-ensure.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
